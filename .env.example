# ==============================================================================
# BundCheck Environment Variables Reference (.env.example)
# ==============================================================================

# General / Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
DOMAIN_NAME=yourdomain.com

# ------------------------------------------------------------------------------
# Database Settings (SQLite default for Local Dev, PostgreSQL for Production)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./test.db

# For Production Docker Compose (PostgreSQL):
POSTGRES_USER=bundcheck
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=bundcheck_db
# DATABASE_URL=postgresql://bundcheck:your_secure_db_password_here@postgres:5432/bundcheck_db

# ------------------------------------------------------------------------------
# LLM Improver Providers (Configure at least one API key)
# ------------------------------------------------------------------------------
DEFAULT_IMPROVER_PROVIDER=groq

# 1. Groq (Recommended default - high throughput, lowest latency)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Multi-model hosted alternative)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 3. OpenAI (GPT models)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Rate Limiting (Token-Bucket per IP)
# ------------------------------------------------------------------------------
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_CHECK=30/minute
RATE_LIMIT_IMPROVE=10/minute
RATE_LIMIT_VERIFY=30/minute
RATE_LIMIT_REPORT=20/minute

# ------------------------------------------------------------------------------
# CORS Allowed Origins (JSON array of strings)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=["https://yourdomain.com", "http://localhost:3000"]

# ------------------------------------------------------------------------------
# Frontend Build Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
